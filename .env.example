# Copy to backend/.env (or the repo root .env). Values below are for a local (non-Docker) run.
PORT=4000
MONGO_URI=mongodb://localhost:27017/supplyshield?replicaSet=rs0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplyshield123
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
ANOMALY_FANIN_WINDOW_HOURS=6
ANOMALY_FANOUT_MULTIPLIER=3
ANOMALY_FANOUT_WINDOW_HOURS=24
# Re-run the detectors automatically this many ms after the sync projects a shipment/batch (0 = off)
ANOMALY_AUTO_RUN_DEBOUNCE_MS=3000
# The app's notion of "today" for expiry checks. Empty -> real clock.
APP_NOW=2026-08-25T00:00:00Z
